{
  "name": "zarya-terminal",
  "productName": "Zarya",
  "version": "0.7.4",
  "description": "Zarya — AI-native terminal with IDE superpowers. A new dawn for your terminal.",
  "main": "./out/main/index.js",
  "author": {
    "name": "gorka2354",
    "email": "99396285+gorka2354@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/gorka2354/zarya-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorka2354/zarya-terminal.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:fake-agents": "npm run build && node scripts/qa-fake-agents.mjs",
    "qa:models": "npm run build && node scripts/qa-claude-catalog.mjs && node scripts/qa-model-refresh.mjs && node scripts/models-test.mjs",
    "qa:codex": "npm run build && node scripts/qa-codex-driver.mjs && node scripts/qa-codex-graceful.mjs",
    "qa:acp": "npm run build && node scripts/qa-acp-driver.mjs && node scripts/qa-acp-graceful.mjs",
    "qa:voice": "npm run build && node scripts/stt-smoke.mjs && node scripts/mic-select-test.mjs && node scripts/stt-model-migration-test.mjs && node scripts/stt-custom-test.mjs",
    "qa:voice-custom": "npm run build && node scripts/stt-custom-live.mjs",
    "qa:agent": "npm run build && node scripts/lp-logic-test.mjs && node scripts/bypass-question-test.mjs && node scripts/lp-live-test.mjs && node scripts/qa-fake-agents.mjs && node scripts/qa-codex-driver.mjs && node scripts/qa-codex-graceful.mjs && node scripts/qa-acp-driver.mjs && node scripts/qa-acp-graceful.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "qa:updates": "npm run build && node scripts/update-view-test.mjs",
    "qa:secrets": "npm run build && node scripts/secret-badge-test.mjs",
    "qa:ui": "npm run build && node scripts/menu-fit-test.mjs && node scripts/popup-toggle-test.mjs && node scripts/ready-line-test.mjs",
    "perf": "npm run build && node scripts/perf-panes.mjs",
    "qa:progress": "npm run build && node scripts/progress-test.mjs",
    "qa:privacy": "npm run build && node scripts/secret-badge-test.mjs && node scripts/history-privacy-test.mjs",
    "qa:commands": "npm run build && node scripts/commands-test.mjs",
    "qa:extras": "npm run build && node scripts/extras-reload-test.mjs",
    "qa:tools": "npm run build && node scripts/mcp-panel-test.mjs",
    "qa:skills": "node scripts/skills-panel-test.mjs",
    "qa:skill-write": "node scripts/skill-write-test.mjs",
    "qa:skill-usage": "node scripts/skill-usage-test.mjs",
    "qa:tools-live": "npm run build && node scripts/tools-live.mjs",
    "qa:routing": "npm run build && node scripts/extras-routing-test.mjs",
    "qa:palette": "npm run build && node scripts/palette-test.mjs",
    "qa:pane-status": "npm run build && node scripts/pane-status-test.mjs",
    "qa:signals": "node scripts/pane-signals-test.mjs",
    "qa:plan": "node scripts/agent-plan-test.mjs",
    "qa:signals-live": "npm run build && node scripts/tool-signals-live.mjs",
    "qa:tool-typing": "npm run build && node scripts/tool-typing-test.mjs",
    "qa:tool-facts": "npm run build && node scripts/tool-facts-test.mjs",
    "qa:tool-image": "npm run build && node scripts/tool-image-test.mjs",
    "qa:pulse": "npm run build && node scripts/tool-pulse-test.mjs",
    "qa:report": "node scripts/agent-report-test.mjs",
    "qa:wave": "node scripts/agent-wave-test.mjs",
    "qa:plan-mode": "node scripts/plan-mode-test.mjs",
    "qa:find": "npm run build && node scripts/feed-search-test.mjs",
    "qa:onboarding": "npm run build && node scripts/onboarding-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@fontsource/handjet": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.6",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sherpa-onnx-node": "^1.13.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
